# Backend (Supabase) — necessário para login e dados.
# Crie um projeto em https://supabase.com e copie em:
#   Project Settings > API
#   - "Project URL"      -> VITE_SUPABASE_URL
#   - "anon public key"  -> VITE_SUPABASE_ANON_KEY  (chave pública, pode ir no frontend)
# Depois copie este arquivo para .env e preencha os valores.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
